try></mxCell><mxCell id="p6-e8" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8E7CB0;strokeWidth=1.4;endArrow=none;endFill=1;dashed=1;fontColor=#E5E7EB;fontSize=12;labelBackgroundColor=#121212;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.0" y="1190.0" as="sourcePoint" /><mxPoint x="335.0" y="1216.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p6-e9" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8A9BB0;strokeWidth=1.4;endArrow=none;endFill=1;dashed=1;fontColor=#E5E7EB;fontSize=12;labelBackgroundColor=#121212;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="1069.5" as="sourcePoint" /><mxPoint x="725.0" y="1069.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p6-e10" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8E7CB0;strokeWidth=1.4;endArrow=none;endFill=1;dashed=1;fontColor=#E5E7EB;fontSize=12;labelBackgroundColor=#121212;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.0" y="1571.0" as="sourcePoint" /><mxPoint x="335.0" y="1597.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Ventas-1" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Registrar venta&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V12&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/ventas/registrar&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color:#5AB4F0;font-weight:bold&quot;&gt;TRABAJADOR&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF37 / CU37, RF43 / CU43, RF45 / CU45, RF61 / CU61&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: menú Ventas → Registrar.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;UI04 aplica descuento y razón antes de confirmar.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Responsable obtenido de sesión, no seleccionable.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;UI01: el escaneo agrega el producto sin confirmar (CU61).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;Comprobante con la categoría vigente de cada producto (CU45).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Registro correcto: prepara nueva venta.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cancelar venta: limpia operación; volver → Inicio.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Errores → conserva venta en curso.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#151E2B;strokeColor=#3D6A9E;strokeWidth=1.2;align=left;ver