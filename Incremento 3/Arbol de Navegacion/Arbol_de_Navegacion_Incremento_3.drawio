erticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="110.0" width="550.0" height="100.0" as="geometry" /></mxCell><mxCell id="Admini-2" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Usuarios&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V03&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/admin/usuarios&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF59 / CU59, RF57&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Administración → Usuarios; Dueño.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Lista las cuentas del sistema.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;Acción Restablecer contraseña sobre una cuenta, con confirmación.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#151E2B;strokeColor=#3D6A9E;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="330.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Admini-3" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C02 PasswordHandler (auth:restablecer-password), C04&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="578.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Admini-4" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Auditoría&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V04&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/admin/auditoria&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF58, RF57 / CU58&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Administración → Auditoría; Dueño.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;Filtros: usuario, tipo de acción y rango de fechas.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;Usuario, rol, fecha/hora, tipo, módulo y descripción.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Solo lectura; orden descendente. Sin resultados: listado vacío.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#151E2B;strokeColor=#3D6A9E;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="330.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Admini-5" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C04 AuditoriaHandler (auditoria:consultar), C03/C05&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="578.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Admini-6" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;Restablecimiento, acción interna (CU59)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Seleccionar cuenta y confirmar.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Temporal de 8 caracteres, visible una sola vez.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Vigencia 24 h; en el próximo login abre V02.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cancelar: sin cambios → Usuarios.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;El restablecimiento no tiene ruta propia.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#D98A3D;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="711.0" width="550.0" height="147.0" as="geometry" /></mxCell><mxCell id="Admini-7" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#F0B452;font-weight:bold&quot;&gt;Acceso rechazado&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Trabajador → acceso denegado y Dashboard.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;El intento queda en el log (CU58 E1).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sesión inválida → bloquear y volver a Login.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C03/C05 verifican acceso por operación.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#1A202B;strokeColor=#3A4556;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="711.0" width="550.0" height="147.0" as="geometry" /></mxCell><mxCell id="Admini-8" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;Registro automático del log (CU58)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cada acción relevante de Dueño o Trabajador: login, registro, edición, anulación,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;exportación y accesos denegados.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C04 lo invocan los controladores; ninguna vista escribe en el log.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Inmutable; se conserva al menos 12 meses.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#D98A3D;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="711.0" width="550.0" height="147.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>