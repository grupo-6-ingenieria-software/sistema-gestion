ont-weight:normal&quot;&gt;C35 RecepcionPedidoHandler, C04&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="740.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Provee-13" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;UI05, Impresión interna&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C33 → UI05 → PDF; C33 → ExcelJS → XLSX.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;No es una vista del menú ni tiene ruta.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Guardar archivo o cancelar → permanece en V25.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#6F6385;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="873.0" width="550.0" height="109.0" as="geometry" /></mxCell><mxCell id="Provee-14" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;Pendiente, sin recepciones&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Acciones: recibir entrega o cancelar pedido.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-heigh