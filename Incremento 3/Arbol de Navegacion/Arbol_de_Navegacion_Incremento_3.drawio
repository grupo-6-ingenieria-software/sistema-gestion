ot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF56 / CU56&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: aplicación sin sesión o sesión invalidada.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Credenciales válidas → shell o cambio obligatorio.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Credenciales inválidas → permanece en Login.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;Temporal vencida (24 h): C01 la rechaza; se pide un nuevo restablecimiento.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#151E2B;strokeColor=#3D6A9E;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="130.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Acceso-2" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C01 AuthHandler, C05 SesionHandler&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="378.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Acceso-3" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Cambio de contraseña&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V02&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/cambiar-contrasena&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color:#5AB4F0;font-weight:bold&quot;&gt;TRABAJADOR&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF56, RF59 / CU56b&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: login con contraseña temporal.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;También tras un restablecimiento hecho en V03 (CU59).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Bloquea la navegación hasta completar el cambio.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cambio correcto → shell autenticado.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Error de validación → conserva el formulario.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#151E2B;strokeColor=#3D6A9E;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="130.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Acceso-4" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C02 PasswordHandler, C05 SesionHandler&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="378.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Acceso-5" value="&lt;div style=&quot;font-size:22px;line-height:32px&quot;&gt;&lt;span style=&quot;color:#1E293B;font-weight:bold&quot;&gt;Shell autenticado&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#334155;font-weight:normal&quot;&gt;/app, DUEÑO / TRABAJADOR&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:22px&quot;&gt;&lt;span style=&quot;color:#334155;font-weight:normal&quot;&gt;Distribuye las entradas de los ocho módulos.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:22px&quot;&gt;&lt;span style=&quot;color:#334155;font-weight:normal&quot;&gt;La autorización se comprueba por operación.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:22px&quot;&gt;&lt;span style=&quot;color:#B45309;font-weight:bold&quot;&gt;Reportes: acceso solo para Dueño.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=44;fillColor=#C9D3E6;strokeColor=#AEB9CF;strokeWidth=1.2;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="130.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Acceso-6" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;Cerrar sesión, acción interna&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Disponible en el shell para ambos roles.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C05 finaliza la sesión y vuelve a /login.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#6F6385;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="551.0" width="550.0" height="203.0" as="geometry" /></mxCell><mxCell id="Acceso-7" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#F0B452;font-weight:bold&quot;&gt;Autorización por operación&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sesión activa + rol efectivo autorizan cada solicitud.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Un permiso de consulta no permite modificar.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cambio de rol: se aplica desde el próximo login.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Desactivación: revoca todas las sesiones abiertas.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;Reportes y Administración: ocultos al Trabajador; por ruta directa → acceso denegado y&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#F5B478;font-weight:normal&quot;&gt;C04 registra el intento (CU58 E1).&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#1A202B;strokeColor=#3A4556;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="551.0" width="550.0" height="203.0" as="geometry" /></mxCell><mxCell id="Acceso-8" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C03, C05; C04 registra los intentos (control transversal)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="780.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Acceso-9" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&g