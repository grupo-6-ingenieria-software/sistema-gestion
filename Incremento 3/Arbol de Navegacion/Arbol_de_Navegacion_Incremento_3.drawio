&quot;&gt;Confirmación de ajuste: cancelar no modifica.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Historial: ingresos, ventas, restituciones, mermas y ajustes manuales; un ingreso se&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;cuenta una vez.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Errores: conservar pantalla y mostrar causa.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Desde cualquier vista: Inicio en el shell.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#6F6385;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="1577.0" width="550.0" height="166.0" as="geometry" /></mxCell><mxCell id="Invent-27" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;UI01, lector EAN-13 (CU60–CU62)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;El lector USB escribe el código y envía Enter.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;UI01 valida 13 dígitos y verificador (C24) y busca sin confirmar (CU61).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Código no encontrado: mensaje de producto no encontrado.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Lectura fallida: suena el lector; UI01 conserva el foco; reintento o ingreso manual (CU62).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sin ruta ni canal IPC propio para el error.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#D98A3D;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="1577.0" width="550.0" height="166.0" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Proveedores y Pedidos"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1467" background="#121212" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4-bg" value="" style="rounded=0;fillColor=#121212;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="1467" as="geometry" /></mxCell><mxCell id="p4-t" value="PROVEEDORES Y PEDIDOS" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#D6DCE6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="2000" height="40" as="geometry" /></mxCell><mxCell id="p4-e0" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8E7CB0;strokeWidth=1.4;endArrow=none;endFill=1;dashed=1;fontColor=#E5E7EB;fontSize=12;labelBackgroundColor=#121212;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.0" y="333.0" as="sourcePoint" /><mxPoint x="335.0" y="359.0" as="targetPoint" /></m