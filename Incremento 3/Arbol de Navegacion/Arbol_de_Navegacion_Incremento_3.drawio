ias por vencimiento ascendente.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Pie: unidades por categoría y costo en riesgo.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Fuera de rango: &quot;Ingrese un valor entre 1 y 31 días&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#26190C;strokeColor=#D98A3D;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="687.0" width="550.0" height="241.0" as="geometry" /></mxCell><mxCell id="Report-11" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C56 ReporteVencimientosHandler, C08; C57 exporta (UI06)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="954.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Report-12" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Rentabilidad por categoría&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V42&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/reportes/rentabilidad&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF51, RF54 / CU51, CU54&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Reportes → Rentabilidad.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Rango de fechas.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Por categoría: unidades, costo, ingreso y margen % con dos decimales.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Orden de mayor a menor margen; costo 0 → N/A al final.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sin datos: tabla vacía.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#26190C;strokeColor=#D98A3D;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="687.0" width="550.0" height="241.0" as="geometry" /></mxCell><mxCell id="Report-13" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C59 ReporteRentabilidadHandler; C57 exporta (UI06)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="954.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Report-14" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Asistencia del personal&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V43&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/reportes/asistencia-personal&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF52, RF54 / CU52, CU54&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Reportes → Asistencia del personal.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Mes, año y rol opcional.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Activos o con actividad en el mes.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Por trabajador: días trabajados, ausencias, horas y promedio.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sin días trabajados: promedio N/A. Sin registros: tabla vacía.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#26190C;strokeColor=#D98A3D;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="1087.0" width="550.0" height="241.0" as="geometry" /></mxCell><mxCell id="Report-15" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C60 ReporteAsistenciaHandler, C51/C43; C57 exporta (UI06)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="1354.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Report-16" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Movimientos de inventario&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V44&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/reportes/movimientos-inventario&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF53, RF54 / CU53, CU54&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Reportes → Movimientos de inventario.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Rango, tipo, categoría y usuario.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Tipos: entrada, venta, anulación de venta, merma y ajuste.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cantidad firmada, stock resultante y usuario; resumen por tipo.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sin movimientos: &quot;No se encontraron movimientos para el período indicado&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/