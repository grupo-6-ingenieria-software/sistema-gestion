&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/personal/ausencias/nueva&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF32 / CU32&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Personal → Registrar ausencia, o acción en V15.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Trabajador, fecha no futura, tipo justificada o injustificada y observación opcional.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Confirmar → mensaje de éxito; queda listo para otro registro.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Fecha futura, asistencia o ausencia existente → error; conserva el formulario.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio o V15.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#26190C;strokeColor=#D98A3D;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="1692.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Person-22" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C50 AusenciaHandler, C21 trabajadores, C04&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="1940.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Person-23" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Registrar remuneración&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V30&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/personal/remuneraciones/nueva&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF34 / CU34&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Personal → Remuneraciones → Registrar.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Activo o con actividad en el mes, incluso inactivo.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Mes/año, bruto, observación; tasas al registrar.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Previsualiza descuentos y líquido.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Guardar: confirma en V30; volver/cancelar → Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#0C2118;strokeColor=#2F8A5B;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="1692.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Person-24" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C44 RemuneracionHandler, C45 tasas, C04&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="1940.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Person-25" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;Cálculo y validación&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Un registro por trabajador, mes y año.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Cada descuento se redondea al peso entero.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Se conservan las tasas aplicadas.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Error de validación: mantener formulario.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#6F6385;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="1390.0" y="1692.0" width="550.0" height="222.0" as="geometry" /></mxCell><mxCell id="Person-26" value="&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&lt;span style=&quot;color:#F1F5F9;font-weight:bold&quot;&gt;Resumen mensual de asistencia&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;V36&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#9AA4B2;font-weight:normal&quot;&gt;/app/personal/asistencia/resumen-mensual&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#4FD1B5;font-weight:bold&quot;&gt;DUEÑO&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;line-height:18px&quot;&gt;&lt;span style=&quot;color:#E8B04B;font-weight:normal&quot;&gt;RF33 / CU33&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Entrada: Personal → Resumen mensual; desde V15 o V19 (Dueño).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Filtros: trabajador, mes y año.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Por día: entrada, salida, HH:MM y estado (Presente, Pendiente o tipo de ausencia).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Pie: días trabajados, horas, ausencias y semanas de lunes a domingo.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sin registros: resumen con totales en cero. Consulta: no exporta.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Volver: Inicio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#26190C;strokeColor=#D98A3D;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="2073.0" width="550.0" height="241.0" as="geometry" /></mxCell><mxCell id="Person-27" value="&lt;div style=&quot;font-size:10px;line-height:16px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;CONTROLADORES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C51 ResumenMensualAsistenciaHandler, C21, C23 (C43)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#231E33;strokeColor=#8E6CC4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=3;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="2340.0" width="550.0" height="53.0" as="geometry" /></mxCell><mxCell id="Person-28" value="&lt;div style=&quot;font-size:17px;line-height:24px&quot;&gt;&lt;span style=&quot;color:#C4A5F5;font-weight:bold&quot;&gt;Reglas de ausencia y resumen&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Ausencia y asistencia del mismo día se excluyen.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;C50 revalida dentro de la transacción; C23 rechaza el marcaje si hay ausencia.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Día trabajado = entrada y salida (Presente).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Sin salida: Pendiente; no cuenta como día trabajado ni suma horas.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:19px&quot;&gt;&lt;span style=&quot;color:#E5E7EB;font-weight:normal&quot;&gt;Semana de lunes a domingo, solo con días del mes consultado.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=28;fillColor=#211D2B;strokeColor=#D98A3D;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=Helvetica;fontColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="725.0" y="2073.0" width="550.0" height="241.0" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="Ventas y Caja"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1710" background="#121212" math="0" shadow="0"><root